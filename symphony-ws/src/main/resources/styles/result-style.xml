<?xml version="1.0" encoding="UTF-8"?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/sld
http://schemas.opengis.net/sld/1.1.0/StyledLayerDescriptor.xsd" version="1.1.0">
  <NamedLayer>
	<Name></Name>
	<UserStyle>
	  <Title>Calc result style</Title>
	  <FeatureTypeStyle>
		<Rule>
		  <RasterSymbolizer>
			<ColorMap type="ramp">
			  <!--
			    Result scale, rainbow from blue to red, 13 stops as fractions of the normalisation value.
			    Derived in the OKLab colour space: a path through the colour family, resampled so each
			    legend step gets an equal share of the total colour difference.
			    No aim: steps are even. Quantities are multiplied by the normalisation value at runtime.
			    The first two entries are not shown in the legend (LegendREST skips transparent entries and
			    entries with the same colour as the next one). Value 0 means no data and stays transparent;
			    values above 0 and below the first stop are drawn in the first colour, opaque.
			  -->
			  <ColorMapEntry color="#5871e3" quantity="0.00" opacity="0"/>
			  <ColorMapEntry color="#5871e3" quantity="0.00001"/>
			  <ColorMapEntry color="#5871e3" quantity="0.01"/>
			  <ColorMapEntry color="#0083fd" quantity="0.05"/>
			  <ColorMapEntry color="#00abff" quantity="0.10"/>
			  <ColorMapEntry color="#00cff6" quantity="0.15"/>
			  <ColorMapEntry color="#00eed9" quantity="0.20"/>
			  <ColorMapEntry color="#28ffa2" quantity="0.25"/>
			  <ColorMapEntry color="#53ff09" quantity="0.30"/>
			  <ColorMapEntry color="#ccff01" quantity="0.40"/>
			  <ColorMapEntry color="#ffee01" quantity="0.50"/>
			  <ColorMapEntry color="#ffc304" quantity="0.60"/>
			  <ColorMapEntry color="#fe9603" quantity="0.70"/>
			  <ColorMapEntry color="#fe6300" quantity="0.80"/>
			  <ColorMapEntry color="#f50002" quantity="1.00"/>
			</ColorMap>
		  </RasterSymbolizer>
		</Rule>
	  </FeatureTypeStyle>
	</UserStyle>
  </NamedLayer>
</StyledLayerDescriptor>
