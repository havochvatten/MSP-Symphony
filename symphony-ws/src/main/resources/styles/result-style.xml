<?xml version="1.0" encoding="UTF-8"?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="http://www.opengis.net/sld
http://schemas.opengis.net/sld/1.1.0/StyledLayerDescriptor.xsd" version="1.1.0">
    <NamedLayer>
        <Name></Name>
        <UserStyle>
            <Title>Calc result style</Title>
            <FeatureTypeStyle>
                <Rule>
                    <RasterSymbolizer>
                        <ColorMap type="ramp">
                            <ColorMapEntry color="#000000" quantity="0.00" opacity="0"/>
                            <ColorMapEntry color="#1a2f9e" quantity="0.01"/>
                            <ColorMapEntry color="#0060ff" quantity="0.05"/>
                            <ColorMapEntry color="#00b0ff" quantity="0.10"/>
                            <ColorMapEntry color="#00e8ff" quantity="0.15"/>
                            <ColorMapEntry color="#00ffbb" quantity="0.20"/>
                            <ColorMapEntry color="#88ff00" quantity="0.25"/>
                            <ColorMapEntry color="#ffe000" quantity="0.30"/>
                            <ColorMapEntry color="#ff8800" quantity="0.40"/>
                            <ColorMapEntry color="#ff2200" quantity="0.50"/>
                            <ColorMapEntry color="#cc0000" quantity="0.60"/>
                            <ColorMapEntry color="#960000" quantity="0.70"/>
                            <ColorMapEntry color="#6a0000" quantity="0.80"/>
                            <ColorMapEntry color="#280000" quantity="1.00"/>
                        </ColorMap>
                    </RasterSymbolizer>
                </Rule>
            </FeatureTypeStyle>
        </UserStyle>
    </NamedLayer>
</StyledLayerDescriptor>
