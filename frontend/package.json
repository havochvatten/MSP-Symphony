{
  "name": "symphony-fe",
  "version": "1.26.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl",
    "build": "ng build",
    "prod-build": "ng build --configuration production",
    "test": "ng test --code-coverage=true",
    "test-headless": "ng test --watch=false --browsers=ChromeCI",
    "test-headless-win": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "format": "prettier \"src/**/*.{js,json,ts,css,less}\" --write",
    "generate-cert": "openssl req -newkey rsa:2048 -x509 -nodes -keyout ssl/server.key -new -out ssl/server.crt -config ssl/openssl-custom.cnf -sha256 -days 365",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@turf/boolean-equal": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/clean-coords": "^7.3.1",
    "@turf/difference": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@types/arcgis-rest-api": "^10.4.8",
    "@types/proj4": "^2.19.0",
    "@types/topojson-specification": "^1.0.5",
    "core-js": "^3.51.0",
    "d3": "^7.9.1",
