    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/language-service": "^21.2.26",
    "@babel/core": "^7.24.5",
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.4",
    "@types/geojson": "^7946.0.14",
    "@types/jasmine": "~7.0.0",
    "@types/jasminewd2": "~2.0.13",
