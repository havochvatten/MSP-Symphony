    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "lint-staged": "^17.6.0",
    "postcss": ">=8.5.32",
    "prettier": "^3.9.10",
    "raw-loader": "^4.0.2",
    "ts-node": "~10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  },
